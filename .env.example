# ==================== LLM ====================
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
LLM_TEMPERATURE=0.3

# ==================== Tavily ====================
TAVILY_API_KEY=
TAVILY_API_BASE=https://api.tavily.com

# ==================== TDAI（可选）====================
TDAI_ENABLED=false
TDAI_GATEWAY_URL=http://127.0.0.1:8420
TDAI_API_KEY=
TDAI_TIMEOUT=30

# ==================== RAG ====================
RAG_BACKEND=json
RAG_USE_TRANSFORMERS=0
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==================== 服务端口 ====================
PORT=8000
LOG_LEVEL=INFO